{
  "name": "rule-engine-monorepo",
  "preview": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "description": "A monorepo of Rule Engine implementation for NodeJS and Browser. It includes a core rule engine and various plugins.",
  "author": {
    "name": "Ali Torki",
    "email": "ali_4286@live.com",
    "url": "https://github.com/ali-master"
  },
  "license": "MIT",
  "scripts": {
    "build": "bun run --workspaces --if-present build",
    "build:demo": "bun run --workspaces --if-present build:demo",
    "lint": "bun run --workspaces --if-present lint",
    "lint:fix": "bun run --workspaces --if-present lint:fix",
    "format:check": "bun fmt --check",
    "format": "bun fmt",
    "test:junit": "bun run --workspaces --if-present test:junit",
    "test:unit": "bun run --workspaces --if-present test:unit",
    "test:types": "bun run --workspaces --if-present test:types",
    "test:knip": "bun run --workspaces --if-present test:knip",
    "test:coverage": "bun run --workspaces --if-present test:coverage",
    "release": "bun run --workspaces --if-present release",
    "release:beta": "bun run --workspaces --if-present release:beta",
    "postinstall": "simple-git-hooks install",
    "test": "bun run test:unit",
    "test:package": "bun run --filter @usex/rule-engine-builder test:package",
    "test:watch": "bun run --workspaces --if-present test:watch",
    "test:bench": "bun run --filter @usex/rule-engine test:bench"
  },
  "devDependencies": {
    "@antfu/eslint-config": "10.0.0",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "changelogithub": "15.0.5",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "installed-check": "11.0.0",
    "knip": "6.44.1",
    "lint-staged": "17.6.0",
    "simple-git-hooks": "2.14.0",
    "standard-version": "^9.5.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unbuild": "^3.6.1",
    "vitest": "5.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx --no-install lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "bun fmt"
    ],
    "*.{json,md,mdx,yml,yaml,toml,css}": [
      "bun fmt"
    ]
  },
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22.12.0"
  },
  "trustedDependencies": [
    "@swc/core",
    "esbuild",
    "simple-git-hooks"
  ]
}
