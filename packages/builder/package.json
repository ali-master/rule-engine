{
  "name": "@usex/rule-engine-builder",
  "type": "module",
  "version": "0.0.4",
  "private": false,
  "description": "Visual rule construction toolkit for React applications. Drag, drop, and compose complex business logic without writing JSON. Transform IF-THEN decisions into intuitive visual flows with real-time evaluation, undo/redo history, and TypeScript-powered intelligence.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ali-master/rule-engine.git",
    "directory": "packages/builder"
  },
  "keywords": [
    "react-rule-builder",
    "visual-rule-engine",
    "business-logic-builder",
    "no-code-rules",
    "decision-tree-builder",
    "if-then-else-builder",
    "visual-programming",
    "business-rules-ui",
    "decision-engine-ui",
    "visual-json-builder",
    "rule-evaluation-ui",
    "interactive-rule-editor",
    "react"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": {
      "import": "./dist/style.css"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "bun check -b && vite build",
    "build:demo": "cd ../core && bun run build && cd ../builder && BUILD_MODE=demo vite build",
    "preview": "vite preview",
    "preview:demo": "BUILD_MODE=demo vite preview --outDir dist-demo",
    "test:types": "bun check -b && bun check -p tests/tsconfig.json",
    "test:unit": "vitest run",
    "test:package": "bun check -p tests/tsconfig.json",
    "test:knip": "knip",
    "test:knip:fix": "knip --fix",
    "format:check": "bun fmt --check",
    "format": "bun fmt",
    "lint": "eslint \"src/**/*.{ts,tsx,js}\"",
    "lint:fix": "bun run lint --fix",
    "prepublishOnly": "bun run lint",
    "release": "CI=true bun run build",
    "postrelease": "standard-version --tag-prefix rule-engine-builder@ && bun publish --access public && git push --follow-tags origin master",
    "release:beta": "bun run build",
    "postrelease:beta": "standard-version --tag-prefix rule-engine-builder@ --prerelease beta && bun publish --access public --tag beta && git push --follow-tags origin master",
    "test:coverage": "vitest run --coverage",
    "test:junit": "vitest run --reporter=junit --outputFile=test-report.junit.xml",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@number-flow/react": "^0.6.2",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@usex/rule-engine": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "framer-motion": "^14.9.0",
    "lucide-react": "1.66.0",
    "react-day-picker": "^10.0.2",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-hook-form": "^7.91.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vaul": "^1.1.2",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
