{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "react", "react-dom", "vite/client"]
  },
  "include": ["src", "tests", "*.config.ts"],
  "exclude": ["tests/package-types.tsx"]
}
